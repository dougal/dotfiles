#!/usr/bin/env bash

set -euo pipefail

# Runs any restic command against a named backup set.
#
# A set is a bash fragment in ~/.config/restic/sets which exports the RESTIC_*
# variables for one repository and lists the arguments its backup should use.
# See restic/sets.example.conf in this repository for the format.

USAGE="Usage:
restic-set <set> <restic command> [args...]

Examples:
restic-set home backup                 # Run the set's configured backup
restic-set home backup --dry-run -v    # Print out changed files
restic-set home snapshots
restic-set home diff 4009d130 bbad2710
restic-set home forget --keep-daily 7 --keep-weekly 4 --prune
restic-set home init                   # Create the repository"

sets_dir="${RESTIC_SETS_DIR:-$HOME/.config/restic/sets}"

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "$USAGE"
  exit 0
fi

set_name="${1:-}"

if [[ -z $set_name ]]; then
  echo "No argument for backup set."
  echo "$USAGE"
  exit 1
fi

shift

conf_path="$sets_dir/$set_name.conf"

if [[ ! -f $conf_path ]]; then
  echo "Unknown backup set: $set_name"
  echo "Expected a config at: $conf_path"
  exit 1
fi

BACKUP_ARGS=()

# shellcheck source=../restic/sets.example.conf
source "$conf_path"

# Have AWS read credentials from the profile and set them as environment
# variables. Restic would fail to re-read the credentials process after a
# period of time and fail the backup.
if [[ ${RESTIC_REPOSITORY:-} == s3:* ]]; then
  # Assigned first so a credentials failure stops here rather than letting
  # restic try the repository anonymously.
  aws_credentials="$(aws configure export-credentials --format env)"
  eval "$aws_credentials"
fi

# `backup` runs the set's configured arguments. Anything else on the command
# line is appended, so extra flags still work.
if [[ ${1:-} == "backup" ]]; then
  shift
  set -- backup ${BACKUP_ARGS[@]+"${BACKUP_ARGS[@]}"} "$@"
fi

exec restic "$@"
